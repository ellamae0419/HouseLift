PORT=3001
ACCESSTOKEN_SECRET="replace-with-a-long-random-string"
REFRESHTOKEN_SECRET="replace-with-a-different-long-random-string"

# DB CONFIG
DB_HOST='localhost'
DB_PORT=3306
DB_USER='root'
DB_PASSWORD=''
DB_DATABASE='house_lift'
# Set to true for hosted databases that require an encrypted connection
DB_SSL=false

# The website address(es) allowed to call this server. Separate several with commas,
# e.g. 'https://houselift.free.nf,https://your-shop-domain.com'
ALLOWED_ORIGIN='http://localhost:1234'
CLIENT_URL='http://localhost:1234'

# EMAIL (Mailjet) CONFIG - leave blank in dev to print emails to the server console instead.
# EMAIL_FROM must be a sender address verified in Mailjet; leave blank to
# fall back to houselift18@gmail.com.
MAILJET_API_KEY=''
MAILJET_SECRET_KEY=''
EMAIL_FROM=''

# SHOP - price shown on the Buy page, in pesos. Leave blank to show
# "Price is confirmed when we contact you" instead of a number.
HYDROLIFT_PRICE_PHP=''

# SMS CONFIG - flood alerts are texted to the owner's mobile number. Leave all of
# these blank in dev to just log instead of sending.
# Free route: an Android phone running "SMS Gateway for Android" (Cloud Server
# mode); the cloud username/password are shown inside that app.
SMS_GATEWAY_USER=''
SMS_GATEWAY_PASSWORD=''
# Paid route (used only when the gateway login above is blank): Semaphore.
# SMS_SENDER_NAME is optional and must be approved in Semaphore first.
SMS_API_KEY=''
SMS_SENDER_NAME=''
